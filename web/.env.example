# Contract ID of the deployed MerkleDrop contract on Stellar (Soroban address, C…).
# Leave unset to start with a blank contract ID field in the web UI.
VITE_DROP_ID=CC64VFG6SEL6QZ75M6CH52V7M4VYSXGXUGLIERPWC5IW6FX3CCD35TDK

# SHA-256 hash of the compiled contract WASM, used to verify the deployed contract.
# Run `stellar contract deploy --wasm-hash` to obtain this value after building.
VITE_DROP_WASM_HASH=f285c779874ada4e128931a52b72d9f1fc7d4ea1a83a395f37d3876d9f1ad900

# Stellar network passphrase. Defaults to testnet if unset.
# Mainnet: "Public Global Stellar Network ; September 2015"
# Testnet: "Test SDF Network ; September 2015"
# VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Soroban RPC endpoint. Defaults to the public testnet RPC.
# VITE_RPC_URL=https://soroban-testnet.stellar.org

# Stellar Expert explorer base URL. Defaults to testnet explorer.
# VITE_EXPLORER=https://stellar.expert/explorer/testnet

# Native XLM Stellar Asset Contract (SAC) address on your target network.
# VITE_XLM_SAC=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
